{
  "name": "browsermcp-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun run --filter @browsermcp/server dev",
    "dev:ext": "bun run --filter @browsermcp/extension dev",
    "build": "bun run --filter '*' build"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
}
